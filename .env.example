# Gemini Vision API Key (Get free key at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Enable Standby/Demo Fallback VLM when Gemini API Key is missing or rate limited
USE_LOCAL_FALLBACK=true

# Upload Storage Directory
UPLOAD_DIR=./tmp_uploads

# Max Question Length (chars)
MAX_QUESTION_LENGTH=500

# Allowed CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,https://*.vercel.app
